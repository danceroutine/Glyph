# Optional only. No API key is needed or read.
# Set after choosing a model once, using its exact catalog slug:
# CHAT_MODEL=
CHAT_TIMEOUT_MS=120000
CHAT_INSTRUCTIONS="You are a helpful assistant. Be clear and concise."
# Full request, response-header, SSE-event, tool, and history tracing. Set to 0 to disable.
CHAT_TRACE=1
# Defaults to ~/.config/harness-chat-chatgpt/harness-trace.log.
# CHAT_TRACE_FILE=
