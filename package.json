{
  "name": "glyph",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first terminal coding agent with ChatGPT authentication and reviewable workspace edits.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "pnpm context-index:build && node --import tsx --env-file-if-exists=.env src/cli.ts",
    "context-index:build": "cargo build --release --package glyph-context-index",
    "context-index:bench": "cargo test --release --package glyph-context-index measures_ -- --ignored --nocapture",
    "context-index:check": "cargo fmt --all --check && cargo clippy --package glyph-context-index --all-targets -- -D warnings",
    "context-index:test": "cargo test --package glyph-context-index",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm format:check && pnpm lint && pnpm context-index:check && pnpm context-index:build && tsc --noEmit",
    "test": "pnpm context-index:test && pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --exclude='**/*.e2e.test.ts' --coverage",
    "test:e2e": "pnpm context-index:build && vitest run --pool=forks --maxWorkers=1 src/application/tests/EditingLoop.e2e.test.ts src/application/tests/ContextInjection.e2e.test.ts src/context/search/tests/RustWorkspacePathIndex.e2e.test.ts src/terminal/tests/TerminalEditing.e2e.test.ts",
    "test:transform-performance": "for size in 1 5 10 20 50; do node --expose-gc --import tsx src/editing/documents/test/TextEditTransformer.benchmark.ts $size; done",
    "test:watch": "vitest",
    "todo:dev": "pnpm --dir examples/todo-app dev",
    "todo:build": "pnpm --dir examples/todo-app build",
    "todo:preview": "pnpm --dir examples/todo-app preview"
  },
  "dependencies": {
    "cli-highlight": "2.1.11",
    "diff": "9.0.0",
    "ink": "8.0.0",
    "jose": "^6.2.12",
    "marked": "^18.1.0",
    "openai": "7.23.0",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "wrap-ansi": "9.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "ink-testing-library": "4.0.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
