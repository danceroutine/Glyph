{
  "name": "glyph",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "glyph": "./dist/cli.js"
  },
  "imports": {
    "#src/*": "./src/*",
    "#code-oss/*": "./code-oss/*",
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    "./desktop-contract": {
      "types": "./dist/desktop/protocol/index.d.ts",
      "import": "./dist/desktop/protocol/index.js"
    },
    "./desktop-host": {
      "types": "./dist/desktop/host/index.d.ts",
      "import": "./dist/desktop/host/index.js"
    }
  },
  "description": "A local-first terminal coding agent with ChatGPT authentication and reviewable workspace edits.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "pnpm context-index:build && pnpm shell-sandbox:build && node --import tsx --env-file-if-exists=.env src/cli.ts",
    "build": "node scripts/build.mjs",
    "desktop:artifact": "pnpm build && pnpm context-index:build && pnpm shell-sandbox:build && node scripts/build-desktop-artifact.mjs",
    "code-oss:bootstrap": "node scripts/code-oss/bootstrap.mjs",
    "code-oss:apply": "node scripts/code-oss/apply-overlay.mjs",
    "code-oss:install": "node scripts/code-oss/run.mjs install",
    "code-oss:check:ui": "tsc -p code-oss/ui/tsconfig.json --noEmit",
    "code-oss:check:storybook": "tsc -p code-oss/storybook/tsconfig.json --noEmit",
    "storybook": "node scripts/code-oss/build-diagram.mjs && storybook dev -c code-oss/storybook -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "node scripts/code-oss/build-diagram.mjs && pnpm code-oss:check:storybook && storybook build -c code-oss/storybook -o .artifacts/storybook --disable-telemetry",
    "code-oss:check:overlay": "tsc -p code-oss/tsconfig.json --noEmit",
    "code-oss:test:aliases": "vitest run --project code-oss",
    "code-oss:compile": "pnpm code-oss:check:ui && pnpm code-oss:apply && pnpm code-oss:check:overlay && node scripts/code-oss/run.mjs run compile-client",
    "code-oss:launch": "node scripts/code-oss/run.mjs launch",
    "code-oss:test:integration": "node scripts/code-oss/test-electron.mjs",
    "context-index:build": "cargo build --release --package glyph-context-index",
    "context-index:bench": "cargo test --release --package glyph-context-index measures_ -- --ignored --nocapture",
    "context-index:check": "cargo fmt --all --check && cargo clippy --package glyph-context-index --all-targets -- -D warnings",
    "context-index:test": "cargo test --package glyph-context-index",
    "shell-sandbox:build": "cargo build --release --package glyph-shell-sandbox",
    "shell-sandbox:check": "cargo clippy --package glyph-shell-sandbox --all-targets -- -D warnings",
    "shell-sandbox:test": "cargo test --package glyph-shell-sandbox",
    "shell-sandbox:torture": "cargo test --release --package glyph-shell-sandbox --test sandbox_e2e -- --ignored --nocapture",
    "shell-sandbox:remediation": "node src/shell/test/remediation/run-remediation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm format:check && pnpm lint && pnpm context-index:check && pnpm shell-sandbox:check && pnpm context-index:build && pnpm shell-sandbox:build && tsc --noEmit && pnpm code-oss:check:ui && pnpm code-oss:check:storybook && pnpm build",
    "test": "run-s --continue-on-error test:parallel test:integration test:coverage",
    "test:parallel": "run-p --continue-on-error --print-label test:native test:suites",
    "test:suites": "run-s test:prepare test:vitest",
    "test:native": "cargo llvm-cov --workspace --fail-under-lines 100 --fail-under-functions 100 --html --output-dir coverage/native -- --include-ignored --skip measures_ && node src/shell/test/remediation/validate-plan.mjs",
    "test:prepare": "pnpm desktop:artifact && pnpm code-oss:bootstrap && pnpm code-oss:install && pnpm code-oss:compile",
    "test:vitest": "rm -rf .artifacts/coverage/v8/components && GLYPH_COMPONENT_COVERAGE_DIR=.artifacts/coverage/v8/components vitest run --coverage",
    "test:integration": "rm -rf .artifacts/coverage/v8/electron && GLYPH_COVERAGE_DIR=.artifacts/coverage/v8/electron node scripts/code-oss/test-electron.mjs",
    "test:coverage": "node scripts/coverage/check-coverage.mjs",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:e2e": "pnpm context-index:build && pnpm shell-sandbox:build && vitest run --project e2e",
    "test:transform-performance": "for size in 1 5 10 20 50; do node --expose-gc --import tsx src/editing/documents/test/TextEditTransformer.benchmark.ts $size; done",
    "test:watch": "vitest",
    "todo:dev": "pnpm --dir examples/todo-app dev",
    "todo:build": "pnpm --dir examples/todo-app build",
    "todo:preview": "pnpm --dir examples/todo-app preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@emotion/css": "11.13.5",
    "better-sqlite3": "13.0.3",
    "cli-highlight": "2.1.11",
    "diff": "9.0.0",
    "entities": "7.0.1",
    "ink": "8.0.0",
    "jose": "^6.2.12",
    "jsonc-parser": "3.3.1",
    "linkedom": "^0.18.13",
    "lowlight": "3.3.0",
    "lucide-preact": "^1.57.0",
    "marked": "^18.1.0",
    "mermaid": "12.2.0",
    "openai": "7.23.0",
    "preact": "11.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "19.3.0",
    "string-width": "8.3.0",
    "wrap-ansi": "9.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@preact/preset-vite": "2.10.6",
    "@storybook/preact-vite": "10.6.1",
    "@testing-library/preact": "3.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "ast-v8-to-istanbul": "1.0.7",
    "esbuild": "0.28.2",
    "eslint-plugin-perfectionist": "5.12.1",
    "ink-testing-library": "4.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
