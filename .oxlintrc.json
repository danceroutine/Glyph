{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-perfectionist", "./scripts/lint/storybook-order.mjs"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["target/**", "dist/**", "coverage/**", ".next/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "max-classes-per-file": "off",
    "max-depth": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-nested-callbacks": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "require-await": "off",
    "typescript/require-await": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "perfectionist/sort-classes": [
      "error",
      {
        "type": "unsorted",
        "groups": [
          ["index-signature", "property", "accessor-property", "function-property", "static-block"],
          "constructor",
          ["public-static-method", "public-static-get-method", "public-static-set-method"],
          ["protected-static-method", "protected-static-get-method", "protected-static-set-method"],
          ["private-static-method", "private-static-get-method", "private-static-set-method"],
          ["public-method", "public-get-method", "public-set-method"],
          ["protected-method", "protected-get-method", "protected-set-method"],
          ["private-method", "private-get-method", "private-set-method"],
          "unknown"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.stories.ts", "**/*.stories.tsx", "**/*.stories.js", "**/*.stories.jsx"],
      "rules": {
        "glyph-storybook/declaration-order": "error"
      }
    },
    {
      "files": ["examples/**/*.ts", "examples/**/*.tsx"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "env": {
        "node": true,
        "vitest": true
      }
    }
  ]
}
