{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-perfectionist", "./scripts/lint/storybook-order.mjs"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["target/**", "dist/**", "coverage/**", ".next/**"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "no-warning-comments": "warn",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "max-classes-per-file": "off",
    "max-depth": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-nested-callbacks": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-single-call": "off",
    "require-await": "off",
    "typescript/require-await": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/strict-void-return": [
      "error",
      {
        "allowReturnAny": true
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "inheritedMethods": false
        }
      }
    ],
    "typescript/prefer-promise-reject-errors": [
      "error",
      {
        "allowThrowingAny": true,
        "allowThrowingUnknown": true
      }
    ],
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "boolean": true,
          "string": true
        }
      }
    ],
    "typescript/no-deprecated": [
      "error",
      {
        "allow": ["validatedIpcMain"]
      }
    ],
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": "CSSProperties",
            "package": "preact"
          }
        ]
      }
    ],
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "no-shadow": [
      "error",
      {
        "ignoreOnInitialization": true
      }
    ],
    "no-inline-comments": [
      "error",
      {
        "ignorePattern": "^\\*\\s*@[a-z]+\\s"
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_register", "_store", "_disposables", "_fillContainer", "_relayout", "_write", "arguments_"]
      }
    ],
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "name": "act",
            "package": "@testing-library/preact"
          }
        ]
      }
    ],
    "perfectionist/sort-classes": [
      "error",
      {
        "type": "unsorted",
        "groups": [
          ["index-signature", "property", "accessor-property", "function-property", "static-block"],
          "constructor",
          ["public-static-method", "public-static-get-method", "public-static-set-method"],
          ["protected-static-method", "protected-static-get-method", "protected-static-set-method"],
          ["private-static-method", "private-static-get-method", "private-static-set-method"],
          ["public-method", "public-get-method", "public-set-method"],
          ["protected-method", "protected-get-method", "protected-set-method"],
          ["private-method", "private-get-method", "private-set-method"],
          "unknown"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.stories.ts", "**/*.stories.tsx", "**/*.stories.js", "**/*.stories.jsx"],
      "rules": {
        "glyph-storybook/declaration-order": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/test/**", "**/tests/**"],
      "rules": {
        "typescript/unbound-method": "off",
        "unicorn/prefer-event-target": "off",
        "typescript/only-throw-error": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "no-throw-literal": "off",
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowConstructorOnly": true,
            "allowEmpty": true,
            "allowStaticOnly": true
          }
        ]
      }
    },
    {
      "files": [
        "scripts/code-oss/tests/GlyphAgentReviewCapture.test.mjs",
        "scripts/code-oss/tests/GlyphDesktopClient.test.mjs",
        "scripts/code-oss/tests/GlyphEditorAdapter.test.mjs",
        "scripts/code-oss/tests/GlyphEditorSnapshotRecovery.test.mjs",
        "scripts/code-oss/tests/GlyphIdeContext.test.mjs",
        "scripts/code-oss/tests/GlyphNativeContextActions.test.mjs",
        "scripts/code-oss/tests/GlyphTrustSynchronization.test.mjs",
        "scripts/code-oss/tests/NativeGlyphWorkbenchService.test.mjs"
      ],
      "rules": {
        "require-unicode-regexp": "off"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-redeclare": "off",
        "typescript/consistent-return": "off"
      }
    },
    {
      "files": ["examples/**/*.ts", "examples/**/*.tsx"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "env": {
        "node": true,
        "vitest": true
      },
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "no-throw-literal": "off",
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowConstructorOnly": true,
            "allowEmpty": true,
            "allowStaticOnly": true
          }
        ]
      }
    },
    {
      "files": ["code-oss/tests/electron/GlyphWorkbench.fixture.mjs"],
      "rules": {
        "no-empty-pattern": "off"
      }
    }
  ]
}
