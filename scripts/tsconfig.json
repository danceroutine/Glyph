{
  "compilerOptions": {
    "rootDir": "..",
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@playwright/test": ["../.code-oss/src/node_modules/@playwright/test/index.d.ts"],
      "electron": ["../.code-oss/src/.build/typings/electron.d.ts"]
